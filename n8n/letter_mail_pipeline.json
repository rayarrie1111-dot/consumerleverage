{
  "name": "Letter Mail Pipeline (Poll → PDF → Lob → Mark Sent)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8000/api/webhooks/pending-letters",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-pending",
      "name": "Fetch Pending Letters",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "check-any",
      "name": "Any Letters?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "letters",
        "options": {}
      },
      "id": "split-letters",
      "name": "Split Into Individual Letters",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [910, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:8000/api/letters/{{ $json.id }}/pdf",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SERVICE_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-pdf",
      "name": "Download Letter PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1130, 200],
      "notes": "Downloads the PDF. Next step: send via Lob or save to disk."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/webhooks/letter-mailed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "letter_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "tracking_number",
              "value": "={{ $json.tracking_number || '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "mark-sent",
      "name": "Mark Letter as Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1350, 200],
      "notes": "After Lob sends the letter, mark it as sent in our system."
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Fetch Pending Letters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Letters": {
      "main": [
        [
          {
            "node": "Any Letters?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Letters?": {
      "main": [
        [
          {
            "node": "Split Into Individual Letters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Into Individual Letters": {
      "main": [
        [
          {
            "node": "Download Letter PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Letter PDF": {
      "main": [
        [
          {
            "node": "Mark Letter as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
